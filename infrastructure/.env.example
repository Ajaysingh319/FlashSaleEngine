# Copy to "infrastructure/.env" and fill in. Docker Compose reads .env automatically; the real .env is git-ignored.

# Initial ADMIN account (Auth Service). Required to create events and ticket types, and by the load test.
# Set both or neither: a valid email and a password of at least 8 characters. Created once, never overwritten.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base64 HS256 key (at least 32 bytes) shared by all services. If empty, the development key in docker-compose.yml
# is used; set your own for anything beyond local development. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional Gateway rate limits per window (PRD 6.11). Defaults: login 10, reservation 10, order 10, payment 5 per 60s.
# LOGIN_RATE_LIMIT=10
# RESERVATION_RATE_LIMIT=10
# ORDER_RATE_LIMIT=10
# PAYMENT_RATE_LIMIT=5
# RATE_LIMIT_WINDOW=60s
