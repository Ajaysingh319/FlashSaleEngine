# Copy to .env.local to override. Vite exposes only VITE_* variables to the browser; never put secrets here.

# "demo": isolated sample data, no backend needed (clearly labelled in the UI).
# "api":  real data through the API Gateway (available from Stage 5).
VITE_DATA_MODE=demo

# API Gateway; the browser never calls individual services.
VITE_API_BASE_URL=http://localhost:8080

# ISO 4217 code used to format ticket prices (the backend stores plain amounts).
VITE_CURRENCY=INR
