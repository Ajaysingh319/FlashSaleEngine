# Optional: copy to .env.local to override. Vite exposes only VITE_* variables to the browser; never put secrets here.

# "api" (default): real data and sign-in through the API Gateway; start the backend first (see the root README).
# "demo": built-in sample data for previewing the design without a backend.
VITE_DATA_MODE=api

# API Gateway; the browser never calls individual services.
VITE_API_BASE_URL=http://localhost:8080

# ISO 4217 code used to format ticket prices (the backend stores plain amounts).
VITE_CURRENCY=INR
